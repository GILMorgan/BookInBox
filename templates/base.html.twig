<!DOCTYPE html>
<html>
    <head>
        <meta charset="UTF-8">
        <title>Book In Box - {% block title %}{% endblock %}</title>
        <!-- <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 128 128%22><text y=%221.2em%22 font-size=%2296%22>⚫️</text><text y=%221.3em%22 x=%220.2em%22 font-size=%2276%22 fill=%22%23fff%22>sf</text></svg>"> -->

		<link href="{{ asset('css/main.css') }}" rel="stylesheet">
        {% block stylesheets %}
        {% endblock %}

		<script src="{{ asset('js/main.js') }}"></script>
        {% block javascripts %}
        {% endblock %}

        {% set frankenphpHotReload = app.request.server.get('FRANKENPHP_HOT_RELOAD') %}
        {% if frankenphpHotReload %}
        <meta name="frankenphp-hot-reload:url" content="{{ frankenphpHotReload }}">
        <script src="https://cdn.jsdelivr.net/npm/idiomorph"></script>
        <script src="https://cdn.jsdelivr.net/npm/frankenphp-hot-reload/+esm" type="module"></script>
        {% endif %}
    </head>
    <body>
		<div class="wrapper">
			<header class="navbar">
				<div class="container row">
					<div class="brand">Book In Box</div>
					<div class="items">
						<div class="loggin">
							{% if is_granted('ROLE_USER') is same as true %}
								<a data-toggle="dropdown-menu">{{ app.user.email }}</a>
								<div class="dropdown-menu" aria-expended="false">
									<a href="{{ path(name = "app_logout") }}" class="dropdown-item">Déconnection</a>
								</div>
							{% else %}
							<a href="{{ path(name = "app_login") }}" class="btn">
								Connexion
							</a>
							{% endif %}
						</div>
					</div>
				</div>
			</header>

			<header class="navbar menu-bar">
				<div class="container row">
					<a class="menu-bar-item" href="{{ path(name = "app_admin_user") }}">Utilisateurs</a>
				</div>
			</header>

			<div class="container">
		        {% block body %}{% endblock %}
			</div>	
		</div>	
    </body>
</html>
